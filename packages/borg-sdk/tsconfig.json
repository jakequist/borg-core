{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,

    // Node runs `.ts` pipelines by erasing types rather than compiling them, so anything that needs
    // a compiler to *emit* something — enums, parameter properties, namespaces — cannot appear in
    // code an author might copy. Better to be unable to write it than to write it and find the
    // pipeline will not start.
    "erasableSyntaxOnly": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "skipLibCheck": true
  },
  "include": ["src", "test"]
}
